#compdef skills

autoload -U is-at-least

_skills() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_skills_commands" \
"*::: :->skills" \
&& ret=0
    case $state in
    (skills)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:skills-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'(--reference)--track=[Branch or tag to inspect without changing any config]:TRACK:_default' \
'(--track)--reference=[Explicit Git ref or full commit to inspect without changing any config]:REFERENCE:_default' \
'--subpath=[Select a source subpath before applying catalog discovery]:SUBPATH:_files' \
'*-i+[Include a selector. Repeated values are ORed]:INCLUDES:_default' \
'*--include=[Include a selector. Repeated values are ORed]:INCLUDES:_default' \
'*-e+[Exclude a selector. Exclusions always win]:EXCLUDES:_default' \
'*--exclude=[Exclude a selector. Exclusions always win]:EXCLUDES:_default' \
'--tree[Render every selected skill'\''s complete artifact tree]' \
'--json[Emit stable machine-readable JSON]' \
'--explain[Explain shadowing, selector decisions, and missing selectors]' \
'--refresh[Re-resolve Git refs instead of using a cached resolution]' \
'-h[Print help]' \
'--help[Print help]' \
':source -- Local path, GitHub shorthand, or Git URL to inspect:_default' \
'*::selectors -- Additional selectors, equivalent to repeated `--include`:_default' \
&& ret=0
;;
(use)
_arguments "${_arguments_options[@]}" : \
'--env=[Select mise'\''s environment-specific config (\`mise.<env>.toml\`)]:ENV:_default' \
'(--global)--path=[Select this mise config file (or mise.toml inside a directory)]:PATH:_files' \
'*--agent=[Agent adapters to record in the declaration]:AGENT:_default' \
'--subpath=[Source-relative skill directory, validated against traversal]:SUBPATH:_default' \
'(--reference)--track=[Branch or tag to resolve now and record as track. Defaults to the remote'\''s default branch]:TRACK:_default' \
'(--track)--reference=[Git ref or full commit to resolve now and record as track]:REFERENCE:_default' \
'(--path)--global[Select the user-owned global mise config]' \
'--locked[Do not resolve or rewrite an existing immutable version]' \
'--allow-source-errors[Tolerate malformed skill files outside the selection; source-wide errors still fail]' \
'-h[Print help]' \
'--help[Print help]' \
':source -- Source (`owner/repository`, `github\:...`, `git\:...`, or `path\:...`):_default' \
'*::selectors -- Optional include selectors; omit to keep an existing selection policy:_default' \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
'--env=[Select mise'\''s environment-specific config (\`mise.<env>.toml\`)]:ENV:_default' \
'(--global)--path=[Select this mise config file (or mise.toml inside a directory)]:PATH:_files' \
'(--path)--global[Select the user-owned global mise config]' \
'--locked[Do not resolve or rewrite any declared version]' \
'-h[Print help]' \
'--help[Print help]' \
'*::tools -- Skill tool keys to refresh. With none, refresh every declaration:_default' \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
'--env=[Select mise'\''s environment-specific config (\`mise.<env>.toml\`)]:ENV:_default' \
'(--global)--path=[Select this mise config file (or mise.toml inside a directory)]:PATH:_files' \
'(--path)--global[Select the user-owned global mise config]' \
'--locked[Require mise'\''s existing lockfile data without resolving tool URLs]' \
'--dry-run[Preview normal mise installation without changing files; skips the direct sync]' \
'--force[Replace unmanaged or changed targets at desired link paths]' \
'--accept-collision[Explicitly accept an unrelated existing \`skills\` executable]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(self-update)
_arguments "${_arguments_options[@]}" : \
'(--global)--path=[Update this mise config file]:PATH:_files' \
'--env=[Select an environment-specific config]:ENV:_default' \
'--version=[Install a specific release from the compatibility manifest]:VERSION:_default' \
'(--path)--global[Update the user-owned global mise config (the default)]' \
'--dry-run[Show the compatible pair and planned changes without installing or editing]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--env=[Select mise'\''s environment-specific config (\`mise.<env>.toml\`)]:ENV:_default' \
'(--global)--path=[Select this mise config file (or mise.toml inside a directory)]:PATH:_files' \
'(--path)--global[Select the user-owned global mise config]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(sync)
_arguments "${_arguments_options[@]}" : \
'--env=[Select mise'\''s environment-specific config (\`mise.<env>.toml\`)]:ENV:_default' \
'(--global)--path=[Select this mise config file (or mise.toml inside a directory)]:PATH:_files' \
'(--path)--global[Select the user-owned global mise config]' \
'--locked[Accepted for the generated postinstall hook; sync never resolves versions]' \
'--force[Replace unmanaged or changed targets at desired link paths]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--env=[Select mise'\''s environment-specific config (\`mise.<env>.toml\`)]:ENV:_default' \
'(--global)--path=[Select this mise config file (or mise.toml inside a directory)]:PATH:_files' \
'(--path)--global[Select the user-owned global mise config]' \
'--json[Emit machine-readable status]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'--env=[Select mise'\''s environment-specific config (\`mise.<env>.toml\`)]:ENV:_default' \
'(--global)--path=[Select this mise config file (or mise.toml inside a directory)]:PATH:_files' \
'(--path)--global[Select the user-owned global mise config]' \
'-h[Print help]' \
'--help[Print help]' \
':tool -- Skill tool key, with or without the `skills\:` prefix:_default' \
'*::selectors -- Explicit include selectors to remove; omit to remove the whole tool:_default' \
&& ret=0
;;
(prune)
_arguments "${_arguments_options[@]}" : \
'--env=[Select mise'\''s environment-specific config (\`mise.<env>.toml\`)]:ENV:_default' \
'(--global)--path=[Select this mise config file (or mise.toml inside a directory)]:PATH:_files' \
'(--path)--global[Select the user-owned global mise config]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(cache)
_arguments "${_arguments_options[@]}" : \
'--clean[Remove every cached entry]' \
'--json[Emit machine-readable JSON]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(validate)
_arguments "${_arguments_options[@]}" : \
'--subpath=[Select a source subpath before validation]:SUBPATH:_files' \
'--json[Emit stable machine-readable diagnostics]' \
'-h[Print help]' \
'--help[Print help]' \
':source -- Source to validate\: local directory, `path\:DIR`, GitHub shorthand, or Git URL:_default' \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
'--subpath=[Select a source subpath before validation]:SUBPATH:_files' \
'--json[Emit stable machine-readable diagnostics]' \
'-h[Print help]' \
'--help[Print help]' \
':source -- Source to validate\: local directory, `path\:DIR`, GitHub shorthand, or Git URL:_default' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate\: bash, zsh, fish, or powershell:(bash zsh fish powershell)' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate\: bash, zsh, fish, or powershell:(bash zsh fish powershell)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_skills__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:skills-help-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(use)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(self-update)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(sync)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(prune)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(cache)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(validate)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_skills_commands] )) ||
_skills_commands() {
    local commands; commands=(
'list:List discovered skills, optionally applying selectors' \
'use:Declare a source and selected skills, resolving its immutable pin' \
'upgrade:Refresh immutable pins for declared sources. This never installs or syncs' \
'install:Install selected configuration tools through normal mise, then sync links' \
'self-update:Update the CLI and its compatible backend as one safe pair' \
'doctor:Diagnose executable collisions and selected mise ownership' \
'sync:Converge the selected configuration without following update tracks' \
'status:Show declared skill sources and their link state' \
'remove:Remove a declaration or selected entries from its include policy' \
'prune:Remove stale links recorded for the selected configuration root' \
'cache:Inspect or clean the immutable source cache used by list' \
'validate:Report strict Agent Skills conformance without blocking normal use' \
'check:Report strict Agent Skills conformance without blocking normal use' \
'completions:Generate a completion script for one supported shell' \
'completion:Generate a completion script for one supported shell' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'skills commands' commands "$@"
}
